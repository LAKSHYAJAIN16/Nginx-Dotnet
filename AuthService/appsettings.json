{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NginxDotNet": {
    "JwtOptions": {
      "SecretKey": "SuperSecretKeyForJwtSigning1234567890!",
      "Issuer": "NginxDotNet",
      "Audience": "NginxDotNetClients"
    },
    "ApiKeyOptions": {
      "HeaderName": "X-API-Key",
      "ValidKeys": {
        "secret-api-key-123": "Client_App_1",
        "admin-api-key-999": "System_Admin"
      }
    },
    "RateLimiter": {
      "MaxRequestsPerWindow": 100,
      "WindowSeconds": 60
    },
    "CacheTTLSeconds": 300
  }
}
